{
  "expo": {
    "name": "TREND Coffee",
    "slug": "order-mobile-app",
    "version": "2.2.10",
    "orientation": "portrait",
    "icon": "./assets/images/trend/logo-icon-padded.png",
    "scheme": "trend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Cho phép ứng dụng sử dụng camera để chụp ảnh đại diện.",
        "NSPhotoLibraryUsageDescription": "Cho phép ứng dụng truy cập thư viện ảnh để chọn ảnh đại diện.",
        "NSPhotoLibraryAddUsageDescription": "Cho phép ứng dụng lưu ảnh hoá đơn và mã QR thanh toán vào thư viện ảnh.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification",
          "fetch"
        ]
      },
      "bundleIdentifier": "com.trendcoffee.order",
      "config": {
        "googleMapsApiKey": "GOOGLE_MAPS_IOS_API_KEY_PLACEHOLDER"
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/trend/logo-icon-padded.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "versionCode": 49,
      "package": "com.trendcoffee.order",
      "config": {
        "googleMaps": {
          "apiKey": "GOOGLE_MAPS_ANDROID_API_KEY_PLACEHOLDER"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/trend/logo-icon-padded.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ứng dụng cần quyền truy cập vị trí để giao hàng đến đúng địa chỉ."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Cho phép ứng dụng truy cập thư viện ảnh để chọn ảnh đại diện.",
          "savePhotosPermission": "Cho phép ứng dụng lưu ảnh hoá đơn và mã QR thanh toán vào thư viện ảnh.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      ["expo-build-properties", {"ios": {"useFrameworks": "static"}}],
      "./plugins/firebase-manifest-merge",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/trend/logo-icon-padded.png",
          "color": "#F7A737",
          "sounds": [
            "./assets/sound/notification.mp3"
          ],
          "defaultChannel": "default"
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/abi-filters",
      "./plugins/remove-permissions",
      "./plugins/android-release-signing",
      "./plugins/ios-static-frameworks-fix"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "jsEngine": "hermes",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "28523d59-faae-4401-9695-53b36ec765ad"
      }
    },
    "owner": "lquyetthangl"
  }
}
